# Копируется в .env: cp .env.example .env   (.env в git не попадает).
# Все значения пустые: пустая переменная = умолчание, указанное в комментарии.
# Ключ для жюри передаётся отдельно (secrets.env.age), его расшифрованное содержимое кладут в .env.

# Адрес OpenAI-совместимого API (OpenAI, Ollama, vLLM и т. п.).
# Умолчание: https://api.openai.com/v1
LLM_BASE_URL=

# Отдельный ключ для жюри; без ключа — режим сохранённых ответов (демо отвечает из кеша).
# Берётся у провайдера из LLM_BASE_URL. Умолчание: пусто.
LLM_API_KEY=

# Имя модели. Кеши демо записаны на gpt-4o-mini. Умолчание: gpt-4o-mini
LLM_MODEL=
