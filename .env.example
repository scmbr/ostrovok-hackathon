# Копируется в .env: cp .env.example .env  (.env в git не попадает, секреты хранить только там).
# docker compose up --build работает и с пустым ключом.

# OpenAI-совместимый endpoint. Подойдёт любой такой API, в том числе локальный:
# Ollama (http://host.docker.internal:11434/v1) или vLLM.
LLM_BASE_URL=https://api.openai.com/v1

# Ключ LLM. Пусто — режим кеша: демо-сценарии отвечают из сохранённых ответов модели,
# свободный текст разбирается правилами, в интерфейсе видна плашка «режим без LLM».
LLM_API_KEY=

# Имя модели. Кеши демо записаны на gpt-4o-mini.
LLM_MODEL=gpt-4o-mini
